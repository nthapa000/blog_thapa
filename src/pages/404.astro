---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="container not-found">
    <h1>404</h1>
    <p>That page doesn't exist.</p>
    <a href="/">&larr; Back home</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: var(--space-6) var(--space-4);
    text-align: center;
  }
</style>
